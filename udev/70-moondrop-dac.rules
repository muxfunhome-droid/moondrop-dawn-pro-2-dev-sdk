# Доступ обычного пользователя к Moondrop DAWN PRO2 (SPV4040) и его загрузчику — нужен для WebHID-флешера в Chrome.
# Установка:
#   sudo cp udev/70-moondrop-dac.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# затем переподключите ЦАП. Chrome запускайте от обычного пользователя, не от root.

# рабочий режим: VID 35d8 (PID 011d)
KERNEL=="hidraw*", ATTRS{idVendor}=="35d8", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="35d8", MODE="0660", TAG+="uaccess"

# загрузчик: после команды входа устройство переподключается как 0666:0888 («USB20»)
KERNEL=="hidraw*", ATTRS{idVendor}=="0666", ATTRS{idProduct}=="0888", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0666", ATTR{idProduct}=="0888", MODE="0660", TAG+="uaccess"
